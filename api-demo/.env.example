# api-demo/.env 로 복사해서 값을 채운다 (.env는 .gitignore 대상, 커밋되지 않는다).
#   cp .env.example .env
#
# CI에서는 이 파일 대신 같은 이름의 환경변수를 시크릿으로 주입한다.
# API 테스트 계정은 UI 테스트 계정(TOOLSHOP_EMAIL/PASSWORD, playwright-demo/.env)과
# 분리되어 있음 — 계정 잠금(423)이 UI/API 양쪽 테스트에 동시에 영향 주는 것을 방지.

API_BASE_URL=https://api.practicesoftwaretesting.com
API_EMAIL=
API_PASSWORD=

# 테스트 데이터 생성/정리(fixture)용 관리자 계정
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 두 번째 고객 계정 (다른 사용자 데이터 접근 검증용)
API_EMAIL2=
API_PASSWORD2=
